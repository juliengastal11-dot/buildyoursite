generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Modèle d'exemple — remplacé au bootstrap par le schéma du blueprint.
model Contact {
  id        String   @id @default(cuid())
  nom       String
  email     String
  message   String
  createdAt DateTime @default(now())
}

// Conservé à CHAQUE bootstrap, quel que soit le schéma du blueprint :
// `lib/reglages.ts` en dépend. Le socle doit compiler seul — ce qu'un de ses
// fichiers suppose, un autre le déclare. Trouvé par un clone dans un dossier
// vide : chaque projet réparait cette contradiction sans le savoir.
model Reglage {
  cle       String   @id
  valeur    String
  updatedAt DateTime @updatedAt
}
